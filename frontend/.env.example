# Address of your deployed Proofmark contract + which network it's on.
# Values are inlined at BUILD time by Next.js -- Vercel rebuilds are required
# after changing these. Real addresses used for this repo's testnet deploys are
# recorded in docs/PROOFMARK_DEPLOYMENT.md.

# Network the contract is deployed on: "studionet" (default) or
# "testnet-bradbury". Maps internally to genlayer-js's studionet /
# testnetBradbury chains.
NEXT_PUBLIC_PROOFMARK_NETWORK=studionet

# Address returned by `genlayer deploy --contract intelligent-contracts/proofmark.py`.
# StudioNet (gasless, used by the Vercel frontend) -- canonical FIX-22 deploy.
# Historical (do not use): 0x589472da571Db60151100b153D65a7170367E17D (pre-rebrand
# Shape B, 37/37 e2e).
NEXT_PUBLIC_PROOFMARK_CONTRACT_ADDRESS=0x849b576f64ecA308300D278223951E4A88e1B5D4
# Bradbury alternative (still the PAYOUT-FIX-20 build -- the FIX-22 build exceeds
# Bradbury's per-tx pubdata cap; see intelligent-contracts/README.md):
# 0xE76AF22aea26A84dB11e87FB946060B02F490217 with NEXT_PUBLIC_PROOFMARK_NETWORK=testnet-bradbury
